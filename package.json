{
  "name": "astro-tanstack-router",
  "version": "0.0.1",
  "private": true,
  "description": "Astro static prerendering + TanStack Router client-side navigation — a read-only guestbook",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync && astro check",
    "lint": "oxlint && pnpm check",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "devalue": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@storybook/tanstack-react": "^10.6.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
