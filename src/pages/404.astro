---
import Layout from "@/layouts/Layout.astro";
import { ErrorView } from "@/react/components/ErrorView";
import { pageTitle } from "@/utils/pageTitle";
---

{/* Static: no router, so ErrorView renders as plain HTML (no client JS). */}
<Layout title={pageTitle("Not found")}>
  <main class="mx-auto w-full max-w-xl px-4 py-10">
    <ErrorView statusCode={404} />
  </main>
</Layout>
