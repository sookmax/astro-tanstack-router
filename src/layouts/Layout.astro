---
import "@/styles/global.css";
import { pageTitle } from "@/utils/pageTitle";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = pageTitle(),
  description = "An Astro + TanStack Router + TanStack Query static starter.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
