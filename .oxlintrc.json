{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["src/react/routeTree.gen.ts"],
  "options": {
    // Type-aware rules + type errors run through oxlint-tsgolint, which bundles
    // its own typescript-go (TS 7) — independent of the `typescript` (6.x)
    // devDependency that `astro check` uses. Keep tsconfig.json valid for both.
    "typeAware": true,
    "typeCheck": true
  }
}
